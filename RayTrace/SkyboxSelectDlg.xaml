<Window x:Class="RayTrace.SkyboxSelectDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTrace"
        mc:Ignorable="d"
        Title="SkyboxSelectDlg" Height="429" Width="432">

    <Grid Margin="8" ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  SelectedItem="{Binding Path=Selection, Mode=TwoWay}" -->

        <!-- https://wpf.2000things.com/2011/10/04/400-using-a-wrappanel-as-the-items-panel-for-a-listbox/ -->
        <ListBox x:Name="skyboxList" ItemsSource="{Binding Path=Skyboxes}" SelectedItem="{Binding Path=Selection, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding Path=TempFile}" Width="240" Height="240"></Image>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
        <!--
        <ItemsControl x:Name="skyboxControl" ItemsSource="{Binding Path=Skyboxes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding Path=TempFile}" Width="240" Height="240"></Image>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        -->
        
        <!--
        <ListView x:Name="listView" ItemsSource="{Binding Path=Skyboxes}" SelectedItem="{Binding Path=Selection, Mode=TwoWay}" ScrollViewer.CanContentScroll="False">
               <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding Path=TempFile}" Width="240" Height="240"></Image>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate> 

            </ListView>
        -->

        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="okButton" Margin="0,0,7,0" Click="okButton_Click" MinWidth="60">OK</Button>
            <Button Name="cancelButton" Click="cancelButton_Click" MinWidth="60">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
