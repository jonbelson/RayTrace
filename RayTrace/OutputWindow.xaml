<Window x:Class="RayTrace.OutputWindow"
        x:Name="outputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTrace"
        mc:Ignorable="d"
        Title="Output Window" Height="800" Width="800" Closing="outputWindow_Closing" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Background="Black">
            <Image x:Name="image" HorizontalAlignment="Center" MinHeight="400" VerticalAlignment="Center" MinWidth="400" Grid.ColumnSpan="2" Stretch="Uniform" MouseDown="image_MouseDown"/>
        </Border>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="progress"  HorizontalAlignment="Stretch" Height="10" VerticalAlignment="Center" MinWidth="100" HorizontalContentAlignment="Stretch" Margin="8,0,8,0" Maximum="{Binding Path=BlocksToDo}" Value="{Binding Path=BlocksDone}" />
            <Button x:Name="buttonCancel" Content="Cancel" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1" Margin="0,8,8,8" Width="44" Click="buttonCancel_Click"/>
            <!--<Label x:Name="label" Content="{Binding ElementName=outputWindow, Path=BlocksDone, Mode=TwoWay}" HorizontalAlignment="Center"  VerticalAlignment="Center" /> -->
        </Grid>
    </Grid>
</Window>
