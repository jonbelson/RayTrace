<Window x:Class="RayTrace.MaterialEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTrace"
        xmlns:brdfs="clr-namespace:RayTrace.Brdfs"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="dialog"
        Title="Material Editor" Height="400" Width="300" ResizeMode="NoResize" SizeToContent="WidthAndHeight">

    <Window.Resources>

        <!--
            Some layout constants.
        -->
        <GridLength x:Key="Column0Width">150</GridLength>
        
        <!--
            Layout hints for controls
        -->
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0, 3" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0, 3" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0, 3" />
            <Setter Property="Width" Value="200"></Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FileBrowseButton" TargetType="Button">
            <Setter Property="Margin" Value="0,2,0,2"></Setter>
        </Style>

        <ObjectDataProvider x:Key="dataFromColourFunctionEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TextureNoise+ColourFunction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="dataFromGradientTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TextureGradient+GradientType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="dataFromBlendTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TextureGradient+BlendType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="dataFromCookTorrenceSurfaceTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="brdfs:CookTorrence+SurfaceType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>



        <local:RgbConverter x:Key="RgbConverter"></local:RgbConverter>

        
        <!--
            Material template
        -->
        <Border x:Shared="False" x:Key="MaterialContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Roughness" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Transparency" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Reflectivity" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Material.Roughness, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Material.Transparency, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Material.Reflectivity, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>

                    <TextBlock Grid.Row="3" Text="Bitmap:" HorizontalAlignment="Right"></TextBlock>
                    <TextBox Grid.Column="2" Grid.Row="3" Text="{Binding ElementName=dialog, Path=material.Texture.FileName, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="TextBox_SourceUpdated"></TextBox>

                    <Button Grid.Column="4" Grid.Row="0" Style="{StaticResource FileBrowseButton}" Click="ButtonNormalMap_Click" Content="..."></Button>

                </Grid>
            </StackPanel>
        </Border>


        <!--
            Colour template.
        -->
        <Border x:Shared="False" x:Key="ColourContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Red"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Green"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Blue"></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>


        <!--
            Colour1 template.
        -->
        <Border x:Shared="False" x:Key="Colour1Content" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour1 R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour1 G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour1 B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Red"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Green"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Blue"></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>


        <!--
            Colour2 template.
        -->
        <Border x:Shared="False" x:Key="Colour2Content" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour2 R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour2 G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour2 B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Red" ></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Green" ></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Blue" ></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>



        <!--
            Solid Texture template.
        -->
        <DataTemplate x:Key="TextureSolidTemplate">

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource ColourContent}"></ContentPresenter>

                </Grid>
        </DataTemplate>



        <!--
            Bitmap Texture template.
        -->
        <DataTemplate x:Key="TextureBitmapTemplate">

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Bitmap:" HorizontalAlignment="Right"></TextBlock>
                    <TextBox Grid.Column="2" Grid.Row="0" Text="{Binding ElementName=dialog, Path=material.Texture.FileName, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="TextBox_SourceUpdated"></TextBox>

                    <Button Grid.Column="4" Grid.Row="0" Style="{StaticResource FileBrowseButton}" Click="Button_Click" Content="..."></Button>
                </Grid>
        </DataTemplate>



        <!--
            Square Texture template.
        -->
        <DataTemplate x:Key="TextureSquaresTemplate">

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource Colour1Content}"></ContentPresenter>
                    <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Content="{StaticResource Colour2Content}"></ContentPresenter>

                    <TextBlock Grid.Row="2" Text="Scale:" HorizontalAlignment="Right"></TextBlock>

                    <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding  ElementName=dialog, Path=material.Texture.Scale, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                </Grid>
        </DataTemplate>



        <!--
            Perlin Noise Texture template.
        -->
        <DataTemplate x:Key="TextureNoiseTemplate">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource Colour1Content}"></ContentPresenter>
                    <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Content="{StaticResource Colour2Content}"></ContentPresenter>

                    <TextBlock Grid.Row="2" Text="Scale:" HorizontalAlignment="Right"></TextBlock>
                    <TextBox Grid.Column="3" Grid.Row="2" Text="{Binding ElementName=dialog, Path=material.Texture.Scale, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                    <TextBlock Grid.Row="3" Text="Function:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Row="3" Grid.Column="3" Name="comboBoxBlendType" ItemsSource="{Binding Source={StaticResource dataFromColourFunctionEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Texture.Function}"  SourceUpdated="Control_SourceUpdated" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxBlendType_SelectionChanged"></ComboBox>


                </Grid>
        </DataTemplate>

        
        <!--
            Gradient Texture template.
        -->
        <DataTemplate x:Key="TextureGradientTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource Colour1Content}"></ContentPresenter>
                    <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Content="{StaticResource Colour2Content}"></ContentPresenter>

                    <TextBlock Grid.Row="2" Text="Direction:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Row="2" Grid.Column="3" Name="comboBoxGradientType" ItemsSource="{Binding Source={StaticResource dataFromGradientTypeEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Texture.Gradient}"  SourceUpdated="Control_SourceUpdated" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxGradientType_SelectionChanged"></ComboBox>

                    <TextBlock Grid.Row="3" Text="Blend:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Row="3" Grid.Column="3" Name="comboBoxBlendType" ItemsSource="{Binding Source={StaticResource dataFromBlendTypeEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Texture.Blend}"  SourceUpdated="Control_SourceUpdated" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxGradientBlendType_SelectionChanged"></ComboBox>

                </Grid>
        </DataTemplate>


        <!--
            Diffuse Material template.
        -->
        <DataTemplate x:Key="DiffuseTemplate">
            <!-- From https://stackoverflow.com/questions/2476305/wpf-some-styles-not-applied-on-datatemplate-controls -->
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}"  SelectedItem="{Binding ElementName=dialog, Path=textureType, Mode=TwoWay}"  SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>
                               
                    <ContentControl x:Name="textureTemplate" Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding  Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <!--<Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}" />-->
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedItem, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Perlin}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog, Mode=TwoWay}" Value="{x:Static local:TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Solid}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog, Mode=TwoWay}" Value="{x:Static local:TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Squares}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Gradient}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Gradient}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureGradientTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Bitmap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureBitmapTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        
                    </ContentControl>

                    
                </Grid>
        </DataTemplate>

        <!--
            Phong Material template.
        -->
        <DataTemplate x:Key="PhongTemplate">
            <!-- From https://stackoverflow.com/questions/2476305/wpf-some-styles-not-applied-on-datatemplate-controls -->
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}" SelectedItem="{Binding ElementName=dialog, Path=textureType, Mode=TwoWay}" SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>

                    <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding  Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <!--<Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}" />-->
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Perlin}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Solid}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Squares}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Gradient}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Gradient}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureGradientTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Bitmap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureBitmapTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>


                    <TextBlock Text="Diffuse:" Grid.Row="2"></TextBlock>
                    <TextBlock Text="Specular:" Grid.Row="3"></TextBlock>
                    <TextBlock Text="Shiness:" Grid.Row="4"></TextBlock>

                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongDiffuse, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="2" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongSpecular, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="3" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongShininess, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="4" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                </Grid>
        </DataTemplate>

        <!--
            Reflective Material template.
        -->
        <DataTemplate x:Key="ReflectiveTemplate">
                <!--        
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource TargetContent}"></ContentPresenter>
-->
        </DataTemplate>

        <!--
            RefractiveAndReflective Material template.
        -->
        <DataTemplate x:Key="RefractiveAndReflectiveTemplate">
            <!-- From https://stackoverflow.com/questions/2476305/wpf-some-styles-not-applied-on-datatemplate-controls -->
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Column0Width}"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Refractive Index" Grid.Row="0"></TextBlock>

                    <TextBox Text="{Binding ElementName=dialog, Path=material.RefractiveIndex, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="0" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                    </Grid>
        </DataTemplate>



        <!--
            BRDF Lambertian Material template.
        -->
        <DataTemplate x:Key="BRDF_LambertianTemplate">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}" SelectedItem="{Binding ElementName=dialog, Path=textureType, Mode=TwoWay}" SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>

                    <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding  Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <!--<Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}" />-->
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Perlin}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Solid}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Squares}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Gradient}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Gradient}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureGradientTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Bitmap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureBitmapTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>

                </Grid>

                <!--        
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource TargetContent}"></ContentPresenter>
-->
        </DataTemplate>


        <!--
            BRDF Cook Torrence Material template.
        -->
        <DataTemplate x:Key="BRDF_CookTorrenceTemplate">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}" SelectedItem="{Binding ElementName=dialog, Path=textureType, Mode=TwoWay}" SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>

                    <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding  Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <!--<Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}" />-->
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Perlin}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Solid}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Squares}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Gradient}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Gradient}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureGradientTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Bitmap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureBitmapTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>

                    <TextBlock Text="Type:" Grid.Row="2"></TextBlock>
                    <TextBlock Text="Roughness:" Grid.Row="3"></TextBlock>
                    <TextBlock Text="Absorption:" Grid.Row="4"></TextBlock>
                    <TextBlock Text="Shininess:" Grid.Row="5"></TextBlock>

                    <ComboBox Name="comboBoxType" ItemsSource="{Binding Source={StaticResource dataFromCookTorrenceSurfaceTypeEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Brdf.Type, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="2"  HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxType_SelectionChanged" SourceUpdated="Control_SourceUpdated"></ComboBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.Roughness, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="3" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.Absorption, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="4" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.Shininess, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="5" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>


                </Grid>
        </DataTemplate>



        <!--
            glTF BRDF Material template.
        -->
        <DataTemplate x:Key="BRDF_GltfTemplate">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Column0Width}"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}" SelectedItem="{Binding ElementName=dialog, Path=textureType, Mode=TwoWay}" SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>

                    <ContentControl Grid.Row="1" Grid.ColumnSpan="5" Content="{Binding ElementName=material, Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Perlin}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Solid}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Squares}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:TextureType.Gradient}">-->
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Gradient}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureGradientTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=textureType, ElementName=dialog}" Value="{x:Static local:TextureType.Bitmap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureBitmapTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                    </ContentControl>

                    <!--<TextBlock Text="Type:" Grid.Row="2"></TextBlock>-->
                    <TextBlock Text="Ior:" Grid.Row="2"></TextBlock>
                    <TextBlock Text="Roughness Factor:" Grid.Row="3"></TextBlock>
                    <TextBlock Text="Metallic Factor:" Grid.Row="4"></TextBlock>
                    <TextBlock Text="Metallic Roughness:" Grid.Row="5"></TextBlock>

                    <!--<ComboBox Name="comboBoxType" ItemsSource="{Binding Source={StaticResource dataFromCookTorrenceSurfaceTypeEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Brdf.Type, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="2"  HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxType_SelectionChanged" SourceUpdated="Control_SourceUpdated"></ComboBox>-->
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.Ior, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="2" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.RoughnessFactor, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="3" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.MetallicFactor, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="4" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Brdf.MetallicRoughnessTexture.FileName, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="5" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>


                </Grid>
        </DataTemplate>






    </Window.Resources>
    
    
    <Grid Margin="8,8,8,0" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Column0Width}"></ColumnDefinition>
            <ColumnDefinition Width="8"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="16" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <Image Grid.ColumnSpan="3" Name="preview" Width="200" Height="200"></Image>
        
        <!-- Name -->
        <TextBlock Grid.Row="1" Text="Name:" HorizontalAlignment="Right"></TextBlock>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=dialog, Path=material.Name, Mode=Twoway}"></TextBox>

        <!-- Normal Map -->
        <TextBlock Grid.Row="2" Text="Normal Map:" HorizontalAlignment="Right"></TextBlock>
        <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding ElementName=dialog, Path=material.NormalMap.FileName, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="TextBox_SourceUpdated"></TextBox>

        <Button x:Name="buttonNormalMap" Style="{StaticResource FileBrowseButton}" Grid.Column="4" Grid.Row="2" Click="ButtonNormalMap_Click" Content="..."></Button>

        <!-- Emissive Map -->
        <TextBlock Grid.Row="3" Text="Emissive Map:" HorizontalAlignment="Right"></TextBlock>
        <TextBox Grid.Column="2" Grid.Row="3" Text="{Binding ElementName=dialog, Path=material.EmissiveTexture.FileName, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="TextBox_SourceUpdated"></TextBox>

        <Button x:Name="buttonEmissiveMap" Style="{StaticResource FileBrowseButton}" Grid.Column="4" Grid.Row="3" Click="ButtonEmissiveMap_Click" Content="..."></Button>

        <!-- Emissive Strength -->
        <TextBlock Grid.Column="0" Grid.Row="4" Text="Emissive Strength:"></TextBlock>

        <TextBox Grid.Column="2" Grid.Row="4" Text="{Binding ElementName=dialog, Path=material.EmissiveStrength, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="TextBox_SourceUpdated"></TextBox>

        <!-- Material Type -->
        <TextBlock Text="Type:" Grid.Row="5" HorizontalAlignment="Right"></TextBlock>
        <ComboBox Grid.Row="5" Grid.Column="2" x:Name="comboBoxMaterialType" SelectionChanged="comboBoxMaterialType_SelectionChanged" HorizontalAlignment="Left" MinWidth="200"></ComboBox>

        <ContentControl Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <!--<Setter Property="ContentTemplate" Value="{StaticResource PhongTemplate}"></Setter>-->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Diffuse}">
                            <Setter Property="ContentTemplate" Value="{StaticResource DiffuseTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Phong}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PhongTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Reflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ReflectiveTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.RefractiveAndReflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource RefractiveAndReflectiveTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.BRDF_Lambertian}">
                            <Setter Property="ContentTemplate" Value="{StaticResource BRDF_LambertianTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.BRDF_CookTorrence}">
                            <Setter Property="ContentTemplate" Value="{StaticResource BRDF_CookTorrenceTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.BRDF_Gltf}">
                            <Setter Property="ContentTemplate" Value="{StaticResource BRDF_GltfTemplate}"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
            <Button Name="okButton" Margin="0,0,7,0" Click="okButton_Click" MinWidth="60">OK</Button>
            <Button Name="cancelButton" Click="cancelButton_Click" MinWidth="60">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
