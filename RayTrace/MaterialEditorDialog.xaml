<Window x:Class="RayTrace.MaterialEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTrace"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="dialog"
        Title="Material Editor" Height="400" Width="300">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TextureNoise+ColourFunction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>


        <local:RgbConverter x:Key="RgbConverter"></local:RgbConverter>

        <Border x:Shared="False" x:Key="MaterialContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Roughness" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Transparency" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Reflectivity" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Material.Roughness, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Material.Transparency, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Material.Reflectivity, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>

                </Grid>
            </StackPanel>
        </Border>


        <!--
            Colour template.
        -->
        <Border x:Shared="False" x:Key="ColourContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Red"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Green"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour.Blue"></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>


        <!--
            Colour1 template.
        -->
        <Border x:Shared="False" x:Key="Colour1Content" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour1 R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour1 G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour1 B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour1.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Red"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Green"></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour1.Blue"></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>


        <!--
            Colour2 template.
        -->
        <Border x:Shared="False" x:Key="Colour2Content" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour2 R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour2 G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour2 B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.Texture.Colour2.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Red" ></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Green" ></Binding>
                                <Binding ElementName="dialog" Path="material.Texture.Colour2.Blue" ></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>





        <!--
            Solid Texture template.
        -->
        <DataTemplate x:Key="TextureSolidTemplate">

            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource ColourContent}"></ContentPresenter>

                </Grid>
            </StackPanel>
        </DataTemplate>



        <!--
            Square Texture template.
        -->
        <DataTemplate x:Key="TextureSquaresTemplate">

            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource Colour1Content}"></ContentPresenter>
                    <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Content="{StaticResource Colour2Content}"></ContentPresenter>

                    <TextBlock Grid.Row="2" Text="Scale:" HorizontalAlignment="Right"></TextBlock>

                    <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding  ElementName=dialog, Path=material.Texture.Scale, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                </Grid>
            </StackPanel>
        </DataTemplate>



        <!--
            Perlin Noise Texture template.
        -->
        <DataTemplate x:Key="TextureNoiseTemplate">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter Grid.Row="0" Grid.ColumnSpan="3" Content="{StaticResource Colour1Content}"></ContentPresenter>
                    <ContentPresenter Grid.Row="1" Grid.ColumnSpan="3" Content="{StaticResource Colour2Content}"></ContentPresenter>

                    <TextBlock Grid.Row="2" Text="Scale:" HorizontalAlignment="Right"></TextBlock>
                    <TextBox Grid.Column="3" Grid.Row="2" Text="{Binding ElementName=dialog, Path=material.Texture.Scale, Mode=TwoWay, NotifyOnSourceUpdated=True}" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                    <TextBlock Grid.Row="3" Text="Function:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Row="3" Grid.Column="3" Name="comboBoxBlendType" ItemsSource="{Binding Source={StaticResource dataFromEnum}, NotifyOnSourceUpdated=True}" SelectedItem="{Binding ElementName=dialog, Path=material.Texture.Function}"  SourceUpdated="Control_SourceUpdated" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="comboBoxBlendType_SelectionChanged"></ComboBox>


                </Grid>
            </StackPanel>
        </DataTemplate>




        <!--
            Diffuse Material template.
        -->
        <DataTemplate x:Key="DiffuseTemplate">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Texture:" HorizontalAlignment="Right"></TextBlock>
                    <ComboBox Grid.Column="2" Name="comboBoxTexture" ItemsSource="{Binding  ElementName=dialog, Path=Textures}" SelectedItem="{Binding Path=Texture}" SelectionChanged="comboBoxTexture_SelectionChanged"></ComboBox>
                               
                    <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding  Path=Texture, Mode=Twoway}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">

                                <!--<Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}" />-->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:MaterialEditorDialog+TextureType.Perlin}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureNoiseTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:MaterialEditorDialog+TextureType.Solid}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSolidTemplate}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxTexture}" Value="{x:Static local:MaterialEditorDialog+TextureType.Squares}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextureSquaresTemplate}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        
                    </ContentControl>

                    
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!--
            Phong Material template.
        -->
        <DataTemplate x:Key="PhongTemplate">
            <!-- From https://stackoverflow.com/questions/2476305/wpf-some-styles-not-applied-on-datatemplate-controls -->
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Diffuse:" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Specular:" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Shiness:" Grid.Row="2"></TextBlock>

                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongDiffuse, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="0" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongSpecular, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="1" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                    <TextBox Text="{Binding ElementName=dialog, Path=material.PhongShininess, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="2" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!--
            Reflective Material template.
        -->
        <DataTemplate x:Key="ReflectiveTemplate">
            <StackPanel>

                <!--        
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource TargetContent}"></ContentPresenter>
-->
            </StackPanel>
        </DataTemplate>

        <!--
            RefractiveAndReflective Material template.
        -->
        <DataTemplate x:Key="RefractiveAndReflectiveTemplate">
            <!-- From https://stackoverflow.com/questions/2476305/wpf-some-styles-not-applied-on-datatemplate-controls -->
            <DataTemplate.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />
            </DataTemplate.Resources>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Refractive Index" Grid.Row="0"></TextBlock>

                    <TextBox Text="{Binding ElementName=dialog, Path=material.RefractiveIndex, Mode=TwoWay, NotifyOnSourceUpdated=True}" Grid.Column="2" Grid.Row="0" MinWidth="50" SourceUpdated="Control_SourceUpdated"></TextBox>

                    </Grid>
                </StackPanel>
        </DataTemplate>





    </Window.Resources>
    
    
    <Grid Margin="8,8,8,0" ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="8"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Image Grid.ColumnSpan="3" Name="preview" Width="200" Height="200"></Image>
        
        <TextBlock Grid.Row="1" Text="Name:" HorizontalAlignment="Right"></TextBlock>
<!--        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=dialog, Path=Test, Mode=Twoway, UpdateSourceTrigger=PropertyChanged}"></TextBox>-->
<!--        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=dialog, Path=Test, Mode=Twoway}"></TextBox>-->
<!--        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=dialog, Path=Name, Mode=Twoway}"></TextBox>-->
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=dialog, Path=material.Name, Mode=Twoway}"></TextBox>

        <TextBlock Text="Type:" Grid.Row="2" HorizontalAlignment="Right"></TextBlock>
        <ComboBox Grid.Row="2" Grid.Column="2" x:Name="comboBoxMaterialType" SelectionChanged="comboBoxMaterialType_SelectionChanged" HorizontalAlignment="Left" MinWidth="200"></ComboBox>

        <!--
            <ContentControl  Grid.Row="3" Grid.ColumnSpan="3" Name="contentControl" Content="{Binding  ElementName=dialog, Path=material, Mode=Twoway}">
                <ContentControl.ContentTemplateSelector>
                    <local:MaterialTypeTemplateSelector DiffuseTemplate="{StaticResource DiffuseTemplate}" PhongTemplate="{StaticResource PhongTemplate}" ReflectiveTemplate="{StaticResource ReflectiveTemplate}" RefractiveAndReflectiveTemplate="{StaticResource RefractiveAndReflectiveTemplate}">
                    </local:MaterialTypeTemplateSelector>
                </ContentControl.ContentTemplateSelector>
            </ContentControl>
-->

<!--
        <ContentControl Grid.Row="3" Grid.ColumnSpan="3" Background="Red" Content="{Binding  ElementName=dialog, Path=material, Mode=Twoway}">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=material.Texture}" Value="{x:Static local:MaterialType.Diffuse}">
                            <Setter Property="ContentTemplate" Value="{StaticResource DiffuseTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=material.Texture}" Value="{x:Static local:MaterialType.Phong}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PhongTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=material.Texture}" Value="{x:Static local:MaterialType.Reflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ReflectiveTemplate}"></Setter>
                            <Setter Property="Background" Value="Blue"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=material.Texture}" Value="{x:Static local:MaterialType.RefractiveAndReflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource RefractiveAndReflectiveTemplate}"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
-->

        <ContentControl Grid.Row="3" Grid.ColumnSpan="3">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <!--<Setter Property="ContentTemplate" Value="{StaticResource PhongTemplate}"></Setter>-->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Diffuse}">
                            <Setter Property="ContentTemplate" Value="{StaticResource DiffuseTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Phong}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PhongTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.Reflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ReflectiveTemplate}"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=SelectedValue, ElementName=comboBoxMaterialType}" Value="{x:Static local:MaterialType.RefractiveAndReflective}">
                            <Setter Property="ContentTemplate" Value="{StaticResource RefractiveAndReflectiveTemplate}"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
            <Button Name="okButton" Margin="0,0,7,0" Click="okButton_Click" MinWidth="60">OK</Button>
            <Button Name="cancelButton" Click="cancelButton_Click" MinWidth="60">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
