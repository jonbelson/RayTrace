<RibbonWindow x:Name="window" x:Class="RayTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTrace"
        mc:Ignorable="d"
        Title="RayTrace" Height="800" Width="800">
    <RibbonWindow.Resources>
        <DataTemplate x:Key="EntityTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <CheckBox IsChecked="{Binding Path=Enabled}">Enabled</CheckBox>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SphereTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

 <!--                   <StackPanel.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={
                                    RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}
                                             }}"
                                             Value="False">
                                    <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>-->
                        <TextBlock Text="Enabled" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Pos" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Radius" Grid.Row="2"></TextBlock>
                        <TextBlock Text="Material" Grid.Row="3"></TextBlock>
                        <TextBlock Text="Texture" Grid.Row="4"></TextBlock>
                        <CheckBox IsChecked="{Binding Path=Enabled, Mode=TwoWay}" Grid.Column="1" Grid.Row="0"></CheckBox>
                        <TextBlock Text="{Binding Path=Pos}" Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock Text="{Binding Path=Radius}" Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock Text="{Binding Path=Material}" Grid.Column="1" Grid.Row="3"></TextBlock>
                        <TextBlock Text="{Binding Path=Material.Texture}" Grid.Column="1" Grid.Row="4"></TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PlaneTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Enabled" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Pos" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Normal" Grid.Row="2"></TextBlock>
                        <TextBlock Text="Material" Grid.Row="3"></TextBlock>
                        <TextBlock Text="Texture" Grid.Row="4"></TextBlock>

                        <CheckBox IsChecked="{Binding Path=Enabled, Mode=TwoWay}" Grid.Column="1" Grid.Row="0"></CheckBox>
                        <TextBlock Text="{Binding Path=Pos}" Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock Text="{Binding Path=Normal}" Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock Text="{Binding Path=Material}" Grid.Column="1" Grid.Row="3"></TextBlock>
                        <TextBlock Text="{Binding Path=Material.Texture}" Grid.Column="1" Grid.Row="4"></TextBlock>
                    </Grid>
                </StackPanel>                
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PointLightTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Enabled" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Pos" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Colour" Grid.Row="2"></TextBlock>
                        <TextBlock Text="Intensity" Grid.Row="3"></TextBlock>

                        <CheckBox IsChecked="{Binding Path=Enabled, Mode=TwoWay}" Grid.Column="1" Grid.Row="0"></CheckBox>
                        <TextBlock Text="{Binding Path=Pos}" Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock Text="{Binding Path=Colour}" Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock Text="{Binding Path=Intensity}" Grid.Column="1" Grid.Row="3"></TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SpotLightTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Enabled" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Pos" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Direction" Grid.Row="2"></TextBlock>
                        <TextBlock Text="Width" Grid.Row="3"></TextBlock>
                        <TextBlock Text="Colour" Grid.Row="4"></TextBlock>
                        <TextBlock Text="Intensity" Grid.Row="5"></TextBlock>

                        <CheckBox IsChecked="{Binding Path=Enabled, Mode=TwoWay}" Grid.Column="1" Grid.Row="0"></CheckBox>
                        <TextBlock Text="{Binding Path=Pos}" Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock Text="{Binding Path=Direction}" Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock Text="{Binding Path=Width}" Grid.Column="1" Grid.Row="3"></TextBlock>
                        <TextBlock Text="{Binding Path=Colour}" Grid.Column="1" Grid.Row="4"></TextBlock>
                        <TextBlock Text="{Binding Path=Intensity}" Grid.Column="1" Grid.Row="5"></TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate> 
    </RibbonWindow.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Ribbon Grid.Row="0" Grid.ColumnSpan="2">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu KeyTip="F">
                    <RibbonApplicationMenuItem Header="About..." />
                    <RibbonApplicationMenuItem Header="Exit" />
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>
            <RibbonTab x:Name="tabRender" Header="Render">
                <RibbonGroup x:Name="groupOptions" Header="Options">
                    <RibbonCheckBox x:Name="checkBoxAmbient" Label="Ambient" ToolTip="Enable ambient lighting"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxLighting" Label="Diffuse" Click="checkBoxLighting_Click" ToolTip="Enable diffuse lighting"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxPhong" Label="Specular" ToolTip="Enable Phong specular highlights"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxRefraction" Label="Refraction" ToolTip="Enable refraction for objects with transparency"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxSoftShadows" Label="Soft Shadows" ToolTip="Enable soft shadows"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxDepthOfField" Label="Depth of Field" ToolTip="Enable depth of field"></RibbonCheckBox>
                    <RibbonSeparator MinWidth="2" MinHeight="55" IsEnabled="True" />
                    <RibbonCheckBox x:Name="checkBoxReflections" Label="Reflections" Click="checkBoxReflections_Click"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textBoxDepth" Label="Depth" IsEnabled="{Binding IsEnabled, ElementName=checkBoxReflections}"></RibbonTextBox>
                </RibbonGroup>


                <!--
                <RibbonGroup x:Name="groupLighting" Header="Lighting">
                    <RibbonCheckBox x:Name="checkBoxLighting" Label="Diffuse" Click="checkBoxLighting_Click" ToolTip="Enable diffuse lighting"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxPhong" Label="Specular" ToolTip="Enable Phong specular highlights"></RibbonCheckBox>
                </RibbonGroup>
                <RibbonGroup x:Name="groupReflections" Header="Reflections">
                    <RibbonCheckBox x:Name="checkBoxReflections" Label="Reflections" Click="checkBoxReflections_Click"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textBoxDepth" Label="Depth" IsEnabled="{Binding IsEnabled, ElementName=checkBoxReflections}"></RibbonTextBox>
                </RibbonGroup>
                <RibbonGroup x:Name="groupRefraction" Header="Refraction">
                    <RibbonCheckBox x:Name="checkBoxRefraction" Label="Refraction" ToolTip="Enable refraction for objects with transparency"></RibbonCheckBox>
                </RibbonGroup>
-->
                
                <RibbonGroup x:Name="groupAntiAliasing" Header="Anti-Aliasing">
                    <RibbonComboBox Label="Type" MinWidth="100">
                        <RibbonGallery x:Name="comboBoxAntiAlias" SelectedValue="None" SelectionChanged="comboBoxAntiAlias_SelectionChanged">
                            <RibbonGalleryCategory x:Name="antiAliasType" ItemsSource="{Binding AntiAliasType, ElementName=window}">
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                    </RibbonComboBox>
                    <RibbonTextBox x:Name="textBoxAdaptiveSubSamplingDepth" Label="Depth"></RibbonTextBox>
                </RibbonGroup>
                <RibbonGroup x:Name="groupEngine" Header="Engine">
                    <RibbonTextBox x:Name="textNumberBlocks" Label="Num. Blocks" Text="{Binding NumRenderBlocks, ElementName=window, Mode=TwoWay}"></RibbonTextBox>
                    <RibbonComboBox SelectionBoxWidth="100" Label="Order">
                        <RibbonGallery x:Name="comboBoxDirection">
                            <RibbonGalleryCategory x:Name="renderDirections" ItemsSource="{Binding RenderDirections, ElementName=window}" />
                        </RibbonGallery>
                    </RibbonComboBox>
                    <!--
                    <RibbonCheckBox x:Name="checkBoxUseThreads" Label="Use Theads" IsChecked="{Binding UseThreads, ElementName=window}"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textMaxThreads" Label="Max Threads" Text="" IsEnabled="{Binding IsChecked, ElementName=checkBoxUseThreads}"></RibbonTextBox>
                    -->
                </RibbonGroup>
            </RibbonTab>
            <RibbonTab x:Name="tabOutput" Header="Output">
                <RibbonGroup x:Name="groupSize" Header="Size">
                    <RibbonTextBox x:Name="textWidth" Label="Width" Text="800" HorizontalAlignment="Right" TextChanged="textWidth_TextChanged"></RibbonTextBox>
                    <RibbonTextBox x:Name="textHeight" Label="Height" Text="800" HorizontalAlignment="Right" IsEnabled="False"></RibbonTextBox>
                </RibbonGroup>
                <RibbonGroup x:Name="groupFile" Header="File">
                    <RibbonCheckBox x:Name="checkBoxSaveImage" Label="Save Image" Click="checkBoxSaveImage_Click" IsChecked="True"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textFileName" Label="File name" Text="Untitled"></RibbonTextBox>
                    <RibbonComboBox Label="Format">
                        <RibbonGallery x:Name="comboBoxFormat" MaxColumnCount="1">
                            <RibbonGalleryCategory x:Name="imageFormat" ItemsSource="{Binding SaveFormats, ElementName=window}"/>
                        </RibbonGallery>
                    </RibbonComboBox>
                    <!--<ComboBox x:Name="comboFormat" IsEditable="True" IsReadOnly="True" ItemsSource="{Binding saveFormats}" MinWidth="100" IsSynchronizedWithCurrentItem="True"/>-->
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <GridSplitter Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5">

        </GridSplitter>

        <DockPanel Grid.Column="0" Grid.Row="1" Margin="8">
            <Button x:Name="buttonRender" Content="Render" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="75" DockPanel.Dock="Bottom" Click="buttonRender_Click" Margin="0,8,0,0"/>
            <ListBox x:Name="listBox" MinHeight="100" VerticalAlignment="Stretch" MinWidth="120" ItemsSource="{Binding Entities, ElementName=window, Mode=TwoWay}">
                <ListBox.ItemTemplateSelector>
                    <local:EntityTemplateSelector SphereTemplate="{StaticResource SphereTemplate}" PlaneTemplate="{StaticResource PlaneTemplate}" PointLightTemplate="{StaticResource PointLightTemplate}" SpotLightTemplate="{StaticResource SpotLightTemplate}">
                        
                    </local:EntityTemplateSelector>
                </ListBox.ItemTemplateSelector>
            </ListBox>
            <!--<TreeView x:Name="treeView"  VerticalAlignment="Stretch" MinHeight="100" VerticalContentAlignment="Stretch" Margin="0" MinWidth="120"/>-->
        </DockPanel>
        <Image x:Name="image" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1"/>

    </Grid>

</RibbonWindow>
