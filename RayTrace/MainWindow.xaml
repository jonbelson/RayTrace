<RibbonWindow x:Name="window" x:Class="RayTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Ribbon.Primitives;assembly=System.Windows.Controls.Ribbon" 
        xmlns:local="clr-namespace:RayTrace"
        mc:Ignorable="d"
        Title="RayTrace" Height="1024" Width="1280" IsVisibleChanged="window_IsVisibleChanged">

    <RibbonWindow.InputBindings>
        <KeyBinding Key="R" Command="{Binding buttonRender}" />
    </RibbonWindow.InputBindings>
    
    <RibbonWindow.Resources>

        <Style x:Key="TreeViewItemStyle_ExpandAll" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected}" />
        </Style>

        <local:RgbConverter x:Key="RgbConverter"></local:RgbConverter>
        <local:DebugExtension x:Key="DebugExtension"></local:DebugExtension>

        <Border x:Shared="False" x:Key="EntityContent" Width="{Binding ElementName=listBox, Path=Width}">
            <Grid Margin="5,5,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition />
                    <!--<RowDefinition />-->
                </Grid.RowDefinitions>
                <!--<TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" Grid.Row="0" Grid.ColumnSpan="3"></TextBlock>-->
                <TextBlock Text="Name" Grid.Row="0"></TextBlock>
                <TextBox Text="{Binding Path=Name}" Grid.Column="2" Grid.Row="0"></TextBox>
                <!--<TextBlock Text="Enabled" Grid.Row="1"></TextBlock>
                <CheckBox IsChecked="{Binding Path=Enabled, Mode=TwoWay, Converter={StaticResource DebugExtension}}" Grid.Column="2" Grid.Row="1"></CheckBox>-->
            </Grid>
        </Border>

        <Border x:Shared="False" x:Key="PositionContent">
            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pos X" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Pos Y" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Pos Z" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Pos.X, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Pos.Y, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Pos.Z, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="2"></TextBox>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Shared="False" x:Key="MatrixContent">
            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Scale" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Rotate X" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Rotate Y" Grid.Row="2"></TextBlock>
                    <TextBlock Text="Rotate Z" Grid.Row="3"></TextBlock>
                    <TextBox Text="{Binding Path=Scale, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=RotateX, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=RotateY, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="2"></TextBox>
                    <TextBox Text="{Binding Path=RotateZ, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="3"></TextBox>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border x:Shared="False" x:Key="TargetContent">
            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Target X" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Target Y" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Target Z" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Target.X, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Target.Y, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Target.Z, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="2"></TextBox>
                </Grid>
            </StackPanel>
        </Border>
        
        <Border x:Shared="False" x:Key="NormalContent">
            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Vector I" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Vector J" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Vector K" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Normal.I, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Normal.J, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Normal.K, Mode=TwoWay, StringFormat={}{0:F3} }" Grid.Column="2" Grid.Row="2"></TextBox>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Shared="False" x:Key="ColourContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Colour R" Grid.Row="0"></TextBlock>
                    <TextBlock Text="Colour G" Grid.Row="1"></TextBlock>
                    <TextBlock Text="Colour B" Grid.Row="2"></TextBlock>
                    <TextBox Text="{Binding Path=Colour.Red, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    <TextBox Text="{Binding Path=Colour.Green, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    <TextBox Text="{Binding Path=Colour.Blue, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    <Rectangle Grid.Column="2" Grid.Row="3" Width="Auto" Height="20" Stroke="Black" Margin="0, 4, 0, 0">
                        <Rectangle.Fill>
                        <MultiBinding Converter="{StaticResource RgbConverter}">
                                <Binding Path="Colour.Red" ></Binding>
                                <Binding Path="Colour.Green" ></Binding>
                                <Binding Path="Colour.Blue" ></Binding>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </StackPanel>
        </Border>

        <Border x:Shared="False" x:Key="MaterialContent" >

            <StackPanel>
                <Grid Margin="5,5,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Material:" Grid.Column="0" Grid.Row="0"></TextBlock>
                    <!--<ComboBox Grid.Row="0" Grid.Column="2" x:Name="comboBoxMaterialType" ItemsSource="{Binding ElementName=window, Path=MaterialTiles}" SelectedValue="{Binding  Path=Name, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="100" SelectionChanged="comboBoxMaterialType_SelectionChanged"></ComboBox>-->
<!--                    <ComboBox Grid.Row="0" Grid.Column="2" x:Name="comboBoxMaterialType" ItemsSource="{Binding ElementName=window, Path=Materials, Converter={StaticResource DebugExtension}}" SelectedValue="{Binding ElementName=window,Path=SelectedEntity2.Material, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="100" SelectionChanged="comboBoxMaterialType_SelectionChanged"></ComboBox>-->
                    <ComboBox Grid.Row="0" Grid.Column="2" x:Name="comboBoxMaterialType" ItemsSource="{Binding ElementName=window, Path=Materials, Converter={StaticResource DebugExtension}}" SelectedValue="{Binding Path=Material,  Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="100" SelectionChanged="comboBoxMaterialType_SelectionChanged"></ComboBox>

                </Grid>
            </StackPanel>
        </Border>

<!--
        <DataTemplate x:Key="EntityTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <CheckBox IsChecked="{Binding Path=Enabled}">Enabled</CheckBox>
            </StackPanel>
        </DataTemplate>
-->        
        
        <!--
            Camera DataTemplate
        -->
        <DataTemplate x:Key="CameraTemplate">
            <StackPanel>
                <TextBlock FontWeight="Bold" Background="LightGray" Text="{Binding Path=Name}" ></TextBlock>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource TargetContent}"></ContentPresenter>
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="FovH" Grid.Row="0"></TextBlock>
                        <TextBlock Text="DoF" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Aperture" Grid.Row="2"></TextBlock>

                        <TextBox Text="{Binding Path=FovH, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                        <TextBox Text="{Binding Path=DepthOfField, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                        <TextBox Text="{Binding Path=Aperture, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>


        <Border x:Shared="False" x:Key="ShapeContent" >
            <StackPanel>
                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource MatrixContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource MaterialContent}"></ContentPresenter>
            </StackPanel>
        </Border>

        <!--
            Sphere DataTemplate
        -->
        <DataTemplate x:Key="SphereTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource ShapeContent}"></ContentPresenter>

                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Radius" Grid.Row="0"></TextBlock>
                        <!--<TextBox Text="{Binding Path=Radius, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>-->
                        <TextBox Text="{Binding Path=Scale, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!--
            Skybox DataTemplate
        -->
        <DataTemplate x:Key="SkyboxTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>

                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Path" Grid.Row="0"></TextBlock>
                        <TextBox IsReadOnly="True" Text="{Binding Path=Directory, Mode=OneWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>


        <!--
            Plane DataTemplate
        -->
        <DataTemplate x:Key="PlaneTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource ShapeContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource NormalContent}"></ContentPresenter>

            </StackPanel>
        </DataTemplate>

        <!--
            Disc DataTemplate
        -->
        <DataTemplate x:Key="DiscTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource ShapeContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource NormalContent}"></ContentPresenter>
                <!--
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Radius" Grid.Row="0"></TextBlock>
                    <TextBox Text="{Binding Path=Radius, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                </Grid>
                -->
            </StackPanel>
        </DataTemplate>
        
        <!--
            Model DataTemplate
        -->
        <DataTemplate x:Key="ModelTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource ShapeContent}"></ContentPresenter>
<!--
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Texture" Grid.Row="2"></TextBlock>

                        <TextBlock Text="{Binding Path=Material.Texture}" Grid.Column="2" Grid.Row="1"></TextBlock>
                    </Grid>
                </StackPanel>
-->                
            </StackPanel>
        </DataTemplate>

        <!--
            ModelSubGroup DataTemplate
        -->
        <DataTemplate x:Key="ModelSubGroupTemplate">
            <StackPanel>
                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource MaterialContent}"></ContentPresenter>
            </StackPanel>
        </DataTemplate>

        <!--
            DistantLight DataTemplate
        -->
        <DataTemplate x:Key="DistantLightTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource NormalContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource ColourContent}"></ContentPresenter>

                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Intensity" Grid.Row="0"></TextBlock>

                        <TextBox Text="{Binding Path=Intensity, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        
        <!--
            PointLight DataTemplate
        -->
        <DataTemplate x:Key="PointLightTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource ColourContent}"></ContentPresenter>

                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Intensity" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Radius" Grid.Row="1"></TextBlock>

                        <TextBox Text="{Binding Path=Intensity, Mode=TwoWay}" Grid.Column="2" Grid.Row="0"></TextBox>
                        <TextBox Text="{Binding Path=Radius, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        
        <!--
            Spotlight DataTemplate
        -->
        <DataTemplate x:Key="SpotLightTemplate">
            <StackPanel>

                <ContentPresenter Content="{StaticResource EntityContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource PositionContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource ColourContent}"></ContentPresenter>
                <ContentPresenter Content="{StaticResource NormalContent}"></ContentPresenter>

                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Direction" Grid.Row="0"></TextBlock>
                        <TextBlock Text="Width" Grid.Row="1"></TextBlock>
                        <TextBlock Text="Intensity" Grid.Row="2"></TextBlock>

                        <TextBox Text="{Binding Path=Width, Mode=TwoWay}" Grid.Column="2" Grid.Row="1"></TextBox>
                        <TextBox Text="{Binding Path=Intensity, Mode=TwoWay}" Grid.Column="2" Grid.Row="2"></TextBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate> 
    </RibbonWindow.Resources>
    
    <!--
        Main window layout
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*" MaxWidth="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Ribbon Bar-->
        <Ribbon Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="1">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu KeyTip="F">
                    <RibbonApplicationMenuItem Header="About..." />
                    <RibbonApplicationMenuItem Header="New Empty Scene..." Click="RibbonApplicationMenuItem_Click" />
                    <RibbonApplicationMenuItem Header="New Minimal Scene..." Click="RibbonApplicationMenuItem_Click_1" />
                    <RibbonApplicationMenuItem Header="Load Scene..." Click="LoadScene_Click" />
                    <RibbonApplicationMenuItem Header="Save Scene" Click="SaveScene_Click" />
                    <RibbonApplicationMenuItem Header="Exit" />
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>
            
            <!-- Preview tab -->
            <RibbonTab x:Name="tabPreview" Header="Preview">
                <RibbonGroup x:Name="groupPreviewOptions" Header="Options">
                    <RibbonCheckBox x:Name="checkBoxGroundPlane" Label="Ground Plane" IsChecked="{Binding ElementName=window, Path=PreviewGroundPlane, Mode=TwoWay}" ToolTip="Enable ground plane" Click="checkBoxGroundPlane_Click"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxAxis" Label="Axis"  IsChecked="{Binding  ElementName=window, Path=PreviewAxis, Mode=TwoWay}" ToolTip="Enable axis" Click="checkBoxAxis_Click"></RibbonCheckBox>
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab x:Name="tabEntities" Header="Entities">
                <RibbonGroup x:Name="groupGeometric" Header="Geometric">

<!--                    <RibbonComboBox Label="1" SmallImageSource="Images/RightArrowShort_Green16.png"-->
 <!--                   <RibbonComboBox Label="1"
                                SelectionBoxWidth="62"
                                VerticalAlignment="Center" 
                                IsEditable="True" > -->
                    <primitives:RibbonMenuItemsPanel Orientation="Horizontal" Width="150"   >
                        <RibbonGallery x:Name="galleryGeometric" SelectedValue="Green"
                                SelectedValuePath="Content"
                                MaxColumnCount="5" SelectionChanged="galleryGeometric_SelectionChanged">
                            <RibbonGalleryCategory >
                                <RibbonGalleryItem Content="Disc"/>
                                <RibbonGalleryItem Content="Plane"/>
                                <RibbonGalleryItem Content="Sphere"/>
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                        </primitives:RibbonMenuItemsPanel>
                    <!--                   </RibbonComboBox> -->

                </RibbonGroup>
                
                <RibbonGroup x:Name="groupModels" Header="Models">
                    <primitives:RibbonMenuItemsPanel Orientation="Horizontal" Width="150"   >
                        <RibbonGallery x:Name="galleryModel" SelectedValue="Green"
                                SelectedValuePath="Content"
                                MaxColumnCount="5" SelectionChanged="galleryModel_SelectionChanged">
                            <RibbonGalleryCategory >
                                <RibbonGalleryItem Content="Model"/>
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                    </primitives:RibbonMenuItemsPanel>
                </RibbonGroup>

                <RibbonGroup x:Name="groupLights" Header="Lights">
                    <primitives:RibbonMenuItemsPanel Orientation="Horizontal" Width="150"   >
                        <RibbonGallery x:Name="galleryLight" SelectedValue="Green"
                                SelectedValuePath="Content"
                                MaxColumnCount="5" SelectionChanged="galleryLight_SelectionChanged">
                            <RibbonGalleryCategory >
                                <RibbonGalleryItem Content="Distant"/>
                                <RibbonGalleryItem Content="Point"/>
                                <RibbonGalleryItem Content="Spot"/>
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                    </primitives:RibbonMenuItemsPanel>
                </RibbonGroup>
            </RibbonTab>
            
            <!-- Render tab -->
            <RibbonTab x:Name="tabRender" Header="Render">
                <RibbonGroup x:Name="groupOptions" Header="Options">
                    <RibbonCheckBox x:Name="checkBoxAmbient" Label="Ambient" ToolTip="Enable ambient lighting"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxLighting" Label="Diffuse" Click="checkBoxLighting_Click" ToolTip="Enable diffuse lighting"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxSpecular" Label="Specular" ToolTip="Enable Phong specular highlights"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxRefraction" Label="Refraction" ToolTip="Enable refraction for objects with transparency"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxShadows" Label="Shadows" ToolTip="Enable shadows"></RibbonCheckBox>
                    <RibbonCheckBox x:Name="checkBoxSoftShadows" Label="Soft Shadows" IsEnabled="{Binding IsChecked, ElementName=checkBoxShadows}" ToolTip="Enable soft shadows"></RibbonCheckBox>
                    <!-- <RibbonCheckBox x:Name="checkBoxGlobalIllumination" Label="Global Illumination" ToolTip="Enable global illumination"></> -->
                    <RibbonCheckBox x:Name="checkBoxDepthOfField" Label="Depth of Field" ToolTip="Enable depth of field"></RibbonCheckBox>
                    <RibbonSeparator MinWidth="2" MinHeight="55" IsEnabled="True" />
                    <RibbonCheckBox x:Name="checkBoxReflections" Label="Reflections" Click="checkBoxReflections_Click"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textBoxDepth" Label="Depth" IsEnabled="{Binding IsEnabled, ElementName=checkBoxReflections}"></RibbonTextBox>

                    <RibbonSeparator MinWidth="2" MinHeight="55" IsEnabled="True" />
                    <RibbonCheckBox x:Name="checkBoxBRDF" Label="BRDF" ToolTip="Enable BRDF"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textBoxBRDFSamples" Label="Samples" IsEnabled="{Binding IsEnabled, ElementName=checkBoxBRDF}"></RibbonTextBox>
                </RibbonGroup>

                <RibbonGroup x:Name="groupGlobalIllumination" Header="Global Illumination">
                    <RibbonCheckBox x:Name="checkBoxGIEnable" Label="Enable"></RibbonCheckBox>
                    <RibbonSeparator MinWidth="2" MinHeight="55" IsEnabled="True" />
                    <RibbonTextBox x:Name="textBoxGINumRays" Label="# Rays" IsEnabled="{Binding IsEnabled, ElementName=checkBoxGIEnable}" ToolTip="Number of scattered rays"></RibbonTextBox>
                    <RibbonTextBox x:Name="textBoxGIDepth" Label="Depth" IsEnabled="{Binding IsEnabled, ElementName=checkBoxGIEnable}" ToolTip="Maximum recursive depth of scattered rays"></RibbonTextBox>
                </RibbonGroup>

                <RibbonGroup x:Name="groupAntiAliasing" Header="Anti-Aliasing">
                    <RibbonComboBox Label="Type" MinWidth="100">
                        <RibbonGallery x:Name="comboBoxAntiAlias" SelectedValue="None" SelectionChanged="comboBoxAntiAlias_SelectionChanged">
                            <RibbonGalleryCategory x:Name="antiAliasType" ItemsSource="{Binding AntiAliasType, ElementName=window}">
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                    </RibbonComboBox>
                    <RibbonTextBox x:Name="textBoxAdaptiveSubSamplingDepth" Label="Depth"></RibbonTextBox>
                </RibbonGroup>
                
                <RibbonGroup x:Name="groupEngine" Header="Engine">
                    <RibbonTextBox x:Name="textNumberBlocks" Label="Num. Blocks" Text="{Binding NumRenderBlocks, ElementName=window, Mode=TwoWay}"></RibbonTextBox>
                    <RibbonComboBox SelectionBoxWidth="100" Label="Order">
                        <RibbonGallery x:Name="comboBoxDirection">
                            <RibbonGalleryCategory x:Name="renderDirections" ItemsSource="{Binding RenderDirections, ElementName=window}" />
                        </RibbonGallery>
                    </RibbonComboBox>
                </RibbonGroup>
            </RibbonTab>
            
            <!-- Output tab -->
            <RibbonTab x:Name="tabOutput" Header="Output">
                <RibbonGroup x:Name="groupRender" Header="Create">
                    <RibbonButton x:Name="buttonRender" Label="Render"  Click="buttonRender_Click"></RibbonButton>
                </RibbonGroup>
                <RibbonGroup x:Name="groupSize" Header="Size">
                    <RibbonTextBox x:Name="textWidth" Label="Width" Text="800" HorizontalAlignment="Right" TextChanged="textWidth_TextChanged"></RibbonTextBox>
                    <RibbonTextBox x:Name="textHeight" Label="Height" Text="800" HorizontalAlignment="Right" IsEnabled="False"></RibbonTextBox>
                </RibbonGroup>
                <RibbonGroup x:Name="groupFile" Header="File">
                    <RibbonCheckBox x:Name="checkBoxSaveImage" Label="Save Image" Click="checkBoxSaveImage_Click" IsChecked="True"></RibbonCheckBox>
                    <RibbonTextBox x:Name="textFileName" Label="File name" Text="Untitled"></RibbonTextBox>
                    <RibbonComboBox Label="Format">
                        <RibbonGallery x:Name="comboBoxFormat" MaxColumnCount="1">
                            <RibbonGalleryCategory x:Name="imageFormat" ItemsSource="{Binding SaveFormats, ElementName=window}"/>
                        </RibbonGallery>
                    </RibbonComboBox>
                    <!--<ComboBox x:Name="comboFormat" IsEditable="True" IsReadOnly="True" ItemsSource="{Binding saveFormats}" MinWidth="100" IsSynchronizedWithCurrentItem="True"/>-->
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <!-- Tool buttons and output image -->
        <DockPanel Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Margin="0">
<!--            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button x:Name="buttonRender2" Content="Render" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="75"  Click="buttonRender_Click" Margin="8,8,0,0"/>
            </StackPanel> -->
<!--
            <Image x:Name="image" HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left" MouseMove="image_MouseMove" MouseLeftButtonDown="image_MouseLeftButtonDown" MinWidth="400" MinHeight="400"/>
-->
            <Border  DockPanel.Dock="Right"  Background="Gray" MouseDown="Border_MouseDown" MouseUp="Border_MouseUp" MouseMove="Border_MouseMove" MouseWheel="Border_MouseWheel">
            <Viewport3D x:Name="viewport3D" MinWidth="200" MinHeight="200" Panel.ZIndex="2" MouseLeftButtonDown="viewport3D_MouseLeftButtonDown">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0, 0, 6" LookDirection="0, 0, -1" UpDirection="0, 1, 0" FieldOfView="45" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>
            </Border>
        </DockPanel>

<!--        <TreeView x:Name="treeView" Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Entities, ElementName=window, Mode=TwoWay}"/> -->
        <!-- List of Entities -->
        <TreeView x:Name="entityTreeView" Grid.Column="1" Grid.Row="1" SelectedItemChanged="entityTreeView_SelectedItemChanged" ItemContainerStyle="{StaticResource TreeViewItemStyle_ExpandAll}" PreviewMouseRightButtonDown="entityTreeView_PreviewMouseRightButtonDown" ContextMenuOpening="entityTreeView_ContextMenuOpening">
            <TreeView.ContextMenu>
                <ContextMenu Name="entityContextMenu">
                    <MenuItem Header="Delete" Click="EntityTreeView_Click"></MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsEnabled="{Binding IsVisible, Mode=OneTime}" IsChecked="{Binding IsChecked, Mode=TwoWay, NotifyOnTargetUpdated=True, NotifyOnSourceUpdated=True}"></CheckBox>
                        <TextBlock Text="{Binding Name}"></TextBlock>
                    </StackPanel>
<!--                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate x:DataType="local:Model">
                            <TreeViewItem Content="{x:Bind Name}"
                           ItemsSource="{x:Bind Children}"
                           IsSelected="{x:Bind IsSelected,Mode=OneWay}"
                           />
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate> -->
                </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

<!--
            <TreeView.Resources>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"></Setter>
                </Style>
            </TreeView.Resources>
            -->
            <!--<TreeViewItem ItemsSource="{Binding Entities, ElementName=window, Mode=TwoWay}" Header="Entities"></TreeViewItem>-->
        </TreeView>

        <!-- Entity properties -->
        <ListBox Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" x:Name="listBox" VerticalAlignment="Stretch" MinWidth="120" ItemsSource="{Binding SelectedEntity, ElementName=window, Mode=TwoWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
            <ListBox.ItemTemplateSelector>
                <local:EntityTemplateSelector CameraTemplate="{StaticResource CameraTemplate}" SphereTemplate="{StaticResource SphereTemplate}"
                                              PlaneTemplate="{StaticResource PlaneTemplate}" DiscTemplate="{StaticResource DiscTemplate}" 
                                              ModelTemplate="{StaticResource ModelTemplate}" ModelSubGroupTemplate="{StaticResource ModelSubGroupTemplate}"
                                              DistantLightTemplate="{StaticResource DistantLightTemplate}" PointLightTemplate="{StaticResource PointLightTemplate}"
                                              SkyboxTemplate="{StaticResource SkyboxTemplate}" SpotLightTemplate="{StaticResource SpotLightTemplate}">
                </local:EntityTemplateSelector>
            </ListBox.ItemTemplateSelector>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="IsSelected" Value="True" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
       
        <!-- Material Tile list -->
        <ListBox Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="3" x:Name="materialListBox" MaxHeight="200" MinWidth="120" ItemsSource="{Binding MaterialTiles, ElementName=window, Mode=TwoWay}" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="materialListBox_MouseDoubleClick" HorizontalContentAlignment="Stretch" ContextMenuOpening="materialListBox_ContextMenuOpening" >
            <ListBox.ContextMenu>
                <ContextMenu Name="materialContextMenu">
                    <MenuItem Header="New" Click="materialContextMenuNew_Click"></MenuItem>
                    <MenuItem Header="Edit" Click="materialContextMenuEdit_Click"></MenuItem>
                    <MenuItem Header="Delete" Click="materialContextMenuDelete_Click"></MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Source="{Binding WriteableBitmap}"></Image>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"></TextBlock>
                    </StackPanel>                        
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Style.Triggers>
                        <!-- Automatically select the item under the mouse pointer -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="IsSelected" Value="True" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <GridSplitter Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="5" />

        <GridSplitter Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" VerticalAlignment="Bottom" Height="5" HorizontalAlignment="Stretch" />

    </Grid>

</RibbonWindow>
